# Claude Code / editor
.claude/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/
.ipynb_checkpoints/

# Data and heavy artefacts (do not version)
# Uses /data/* rather than /data/ : git does not evaluate negations inside a directory
# that is already excluded, so the directory must stay "visitable".
/data/*
*.h5
*.npy
*.npz
*.pt
*.pth
*.ckpt

# EXCEPTION: the manifest defines the train/val/test split by cluster. It is 164 KB and
# without it a collaborator rebuilding the dataset generates a DIFFERENT split, which
# makes any number incomparable with the ones already measured.
!/data/manifest.csv

# EXCEPTION: the plain-text split lists, derived from the manifest. They are the proof
# of the anti-leakage protocol, checkable without opening a 165 KB CSV.
!/data/splits/
!/data/splits/*.txt

# Outputs - /outputs/* for the same reason as /data/*. The subfolders (which hold the
# .pt files) stay excluded; only the loose top-level files are re-included below.
/outputs/*
/logs/
wandb/
*.log

# EXCEPTION: the weights (.pt, 265 MB) stay out, but the EVIDENCE stays in -
# dense gates, bootstraps and the learning curve add up to 136 KB. Without them,
# checking a number would require rerunning 7 evaluations over 494 chains.
# Must come AFTER *.log for the negation to take effect.
!/outputs/*.txt
!/outputs/*.csv
!/outputs/*.log
# Loose top-level .npz files are small tables, not weights: propensity_table.npz is 72 KB
# and is what allows rescoring the baseline without recounting the whole training split.
!/outputs/*.npz

# SO
.DS_Store

# PERSONAL working documents - shared out of band, never versioned.
/PLANO.md
/PLANO_EXECUCAO.md
/DADOS.md
/resumo.tex
/resumo_projeto.txt
/revisao_literatura.txt
/avaliacao_sugestoes.txt
/docs/
